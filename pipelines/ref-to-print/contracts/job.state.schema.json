{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "job.state/1",
  "title": "Job state (read and written only by the r2p driver)",
  "description": "Order is fixed: S0, S1, G1, S2, G2, S3, G3, S4. A step can start only when every step before it is done.",
  "type": "object",
  "required": ["schema", "job", "steps", "escalated"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "job.state/1"},
    "job": {"type": "string"},
    "escalated": {"type": "boolean", "description": "True when the driver must stop and a person or a stronger model must look"},
    "escalation_reason": {"type": ["string", "null"]},
    "params": {
      "type": "object",
      "description": "Numbers a follow-up run may change: clearance_mm, min_wall_mm, and so on",
      "additionalProperties": true
    },
    "steps": {
      "type": "object",
      "required": ["S0", "S1", "G1", "S2", "G2", "S3", "G3", "S4"],
      "additionalProperties": false,
      "patternProperties": {
        "^(S[0-4]|G[1-3])$": {
          "type": "object",
          "required": ["status", "attempts"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["pending", "done", "failed"]},
            "attempts": {"type": "integer", "minimum": 0},
            "needs": {"enum": ["none", "modelling", "person"], "description": "modelling and person steps are never run by a local driver"},
            "report": {"type": ["string", "null"], "description": "Path of the last report, relative to the job folder"},
            "updated": {"type": ["string", "null"], "description": "ISO 8601 time"},
            "note": {"type": ["string", "null"]}
          }
        }
      }
    }
  }
}
